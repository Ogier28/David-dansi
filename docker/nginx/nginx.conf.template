# Modèle de configuration Nginx. L'entrypoint y injecte le port fourni par
# l'hébergeur, puis écrit le résultat dans /etc/nginx/nginx.conf.
# Seule la variable PORT est substituée : les variables propres à Nginx
# ($uri, $query_string, $realpath_root...) sont préservées telles quelles.

user  www-data;
worker_processes  auto;
pid /run/nginx/nginx.pid;

error_log /dev/stderr warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout combined;

    sendfile           on;
    tcp_nopush         on;
    tcp_nodelay        on;
    server_tokens      off;
    keepalive_timeout  30;
    client_max_body_size 8m;

    # Dossiers temporaires accessibles à www-data.
    client_body_temp_path /var/lib/nginx/tmp/client_body;
    proxy_temp_path       /var/lib/nginx/tmp/proxy;
    fastcgi_temp_path     /var/lib/nginx/tmp/fastcgi;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   256;
    gzip_proxied      any;
    gzip_types
        application/javascript
        application/json
        application/xml
        application/rss+xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    server {
        listen      ${PORT};
        server_name _;

        root  /var/www/html/public;
        index index.php;
        charset utf-8;

        # Assets Vite : le nom de fichier contient un hachage, donc cache long.
        location ^~ /build/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }

        # Polices auto-hébergées : elles ne changent jamais.
        location ^~ /fonts/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }

        location ~* \.(?:webp|avif|png|jpe?g|gif|svg|ico)$ {
            expires 30d;
            add_header Cache-Control "public";
            access_log off;
            try_files $uri =404;
        }

        # Tout le reste passe par Laravel (y compris /sitemap.xml et /robots.txt,
        # qui sont des routes et non des fichiers).
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            try_files $uri =404;

            fastcgi_pass   127.0.0.1:9000;
            fastcgi_index  index.php;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param  DOCUMENT_ROOT   $realpath_root;
            fastcgi_hide_header X-Powered-By;
            fastcgi_read_timeout 60s;
        }

        # Aucun fichier caché n'est servi (.env, .git, etc. ne sont de toute
        # façon pas dans public/, c'est une ceinture de sécurité).
        location ~ /\. {
            deny all;
        }
    }
}
