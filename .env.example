APP_NAME="Dansi David"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En développement : SQLite, aucun serveur à installer.
# En production (Render, MySQL, PostgreSQL) : remplacez par pgsql ou mysql
# et renseignez les cinq variables ci-dessous.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=portfolio
# DB_USERNAME=portfolio
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# À passer à true dès que le site est servi en HTTPS.
# SESSION_SECURE_COOKIE=true

# Derrière un proxy ou un répartiteur de charge (Render, Cloudflare), permet à
# Laravel de voir le schéma et l'adresse IP réels du visiteur.
# « * » fait confiance à tous les proxys, une liste d'IP séparées par des
# virgules les restreint. Laisser vide en développement.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="site@dansidavid.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Formulaire de contact
# Adresse qui reçoit les demandes, délai minimum (secondes) avant qu'une
# soumission soit considérée comme humaine, et durée de validité du formulaire.
CONTACT_RECIPIENT=contact@dansidavid.com
CONTACT_MIN_DELAY=3
CONTACT_MAX_AGE=7200

# Cloudflare Turnstile — captcha invisible du formulaire de contact.
# Clés gratuites : https://dash.cloudflare.com/?to=/:account/turnstile
# Laisser vide en développement : le formulaire reste protégé par le honeypot,
# le délai minimum et le limiteur de débit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
